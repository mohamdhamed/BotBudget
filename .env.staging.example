# =============================================
# STAGING ENVIRONMENT — بوت الاختبار
# =============================================
# انسخ هذا الملف إلى .env.staging وعدّل القيم
# cp .env.staging.example .env.staging

# Telegram Bot — بوت اختبار منفصل (مش @Mybudgettracke_bot)
TELEGRAM_BOT_TOKEN=your_TEST_bot_token_here

# Google Gemini AI — نفس الـ key أو key منفصل
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL — قاعدة بيانات منفصلة تماماً
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bot_budget_staging
DB_USER=botbudget_user
DB_PASS=your_secure_password_here

# Security — Telegram IDs المسموح ليهم بالاستخدام (أنت بس في الـ staging)
ALLOWED_USER_IDS=your_telegram_id_here

# Rate Limiting
RATE_LIMIT_MESSAGES=30
RATE_LIMIT_WINDOW_SECONDS=60

# Admin Dashboard — على بورت 8081 (مختلف عن production 8080)
DASHBOARD_USER=admin
DASHBOARD_PASS=change_this_to_a_strong_password
DASHBOARD_PREFIX=/admin

# Groq AI (fallback)
GROQ_API_KEY=your_groq_api_key_here

# Environment identifier
ENVIRONMENT=staging
